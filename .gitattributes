* text=auto
*.bat text eol=crlf
*.png binary
*.gif binary

# Preserve the checksum of the pinned Lucide SVG on Windows.
/assets/artwork/tray/lucide-mic.svg text eol=lf
/assets/artwork/tray/lucide-speaker.svg text eol=lf
/assets/artwork/tray/lucide-webcam.svg text eol=lf
/assets/artwork/tray/lucide-heart-pulse.svg text eol=lf
/assets/artwork/tray/lucide-house.svg text eol=lf
/assets/artwork/tray/lucide-watch.svg text eol=lf
/assets/artwork/tray/lucide-tv-minimal.svg text eol=lf
/assets/artwork/tray/lucide-radar.svg text eol=lf
/assets/artwork/tray/lucide-smartphone.svg text eol=lf
/assets/artwork/tray/filled/*.svg text eol=lf
/assets/artwork/settings/*.svg text eol=lf

# Preserve verbatim upstream license notices, including their whitespace.
/halo/iconify_data/*-LICENSE.txt -text -whitespace
